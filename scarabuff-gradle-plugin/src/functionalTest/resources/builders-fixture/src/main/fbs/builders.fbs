// Every field kind the builder generator supports, plus the naming and default edge cases.
include "common.fbs";

namespace com.probe.builders;

enum Color:byte { Red, Green = 3 }
enum Level:ubyte { Low, High }

table Inner { v:int; label:string; }

struct Vec2 { x:float; y:float; }
// Nested struct, enum and bool inside a struct.
struct Pose { position:Vec2; angle:double; color:Color; visible:bool; }
// Keyword field names: flatc's accessors become in_ and is_.
struct Bounds { in:int; is:int; }

table Shapes {
  origin:Vec2;
  pose:Pose (required);
  path:[Vec2];
  other_ns:com.probe.common.Point;
  bounds:Bounds;
  poses:[Pose];
}

table All {
  a_bool:bool = true;
  a_byte:byte = -2;
  a_ubyte:ubyte = 7;
  a_short:short;
  a_ushort:ushort;
  a_int:int = 42;
  a_uint:uint = 9;
  a_long:long = -5;
  // flatc's own Kotlin output doesn't compile for ulong defaults above Long.MAX_VALUE.
  a_ulong:ulong = 6;
  a_float:float = 1.5;
  a_double:double = 2.25;
  color:Color = Green;
  level:Level = High;
  nan_float:float = nan;
  inf_double:double = -inf;
  some_text:string;
  inner:Inner;
  other_ns:com.probe.common.Shared;
  v_bool:[bool];
  v_byte:[byte];
  v_ubyte:[ubyte];
  v_short:[short];
  v_ushort:[ushort];
  v_int:[int];
  v_uint:[uint];
  v_long:[long];
  v_ulong:[ulong];
  v_float:[float];
  v_double:[double];
  v_color:[Color];
  v_string:[string];
  v_inner:[Inner];
  opt_int:int = null;
  old:int (deprecated);
  object:int;
  when:[string];
}

table Strict {
  name:string (required);
  inner:Inner (required);
  ids:[int] (required);
}

root_type Strict;
file_identifier "STRT";

// Line wrapping: KotlinPoet wraps long generated lines, and a break before a lambda's `{` doesn't
// compile. NumPayload is the schema from the 0.4.0 bug report; the long names move the wrap point
// across the other lambda-emitting field kinds and the gRPC stub.
struct NumItem { id:long; score:double; active:bool; }
table NumPayload { id:long; items:[NumItem]; }

table AVeryLongTableNameThatPushesGeneratedLinesPastTheWrapLimit {
  a_rather_long_vector_of_structs_field_name:[NumItem];
  another_rather_long_vector_of_strings_field:[string];
  yet_another_long_vector_of_nested_tables:[Inner];
  an_optional_scalar_with_a_long_field_name:int = null;
  an_optional_struct_with_a_long_field_name:NumItem;
}

rpc_service AVeryLongServiceNameThatPushesGeneratedLinesPastTheWrapLimit {
  AVeryLongMethodNameForTheUnaryCase(AVeryLongTableNameThatPushesGeneratedLinesPastTheWrapLimit):NumPayload;
  AVeryLongMethodNameForTheBidiCase(AVeryLongTableNameThatPushesGeneratedLinesPastTheWrapLimit):NumPayload (streaming: "bidi");
}

// An empty table: its spec is a plain class, since a data class needs a property.
table Empty {}

// Unions of tables: a member's spec is passed directly. Members can come from another namespace
// and have required fields of their own. (A required union field doesn't work: flatc's own Kotlin
// for it doesn't compile.)
union Payload { Inner, Strict, com.probe.common.Shared }
table WithUnion { payload:Payload; other:Payload; }
table HoldsUnion { held:WithUnion; }

// A table listed twice under different names: a spec can't say which is meant, so no builders
// for WithAliased, nor for HoldsAliased, which nests it.
union Aliased { First: Inner, Second: Inner }
table WithAliased { which:Aliased; }
table HoldsAliased { held:WithAliased; }
